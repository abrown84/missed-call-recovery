# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BRWN Text relay (outbound SMS via Android device node; Mac node later)
# https:// — remote relays must use HTTPS
BRWN_RELAY_URL=https://relay.example.com
# Sender token — Authorization: Bearer … on POST /api/messages
BRWN_RELAY_SENDER_TOKEN=your_sender_token
# Optional request timeout in ms (default 15000)
# BRWN_RELAY_TIMEOUT_MS=15000

# Shared secret for events INTO this app (missed-call, inbound, status).
# Device and relay must send: Authorization: Bearer $BRWN_WEBHOOK_SECRET
BRWN_WEBHOOK_SECRET=generate-a-long-random-string

# Fallback business phone when the relay inbound webhook omits `to`/`businessPhone`.
# Should match businesses.phone for the BRWN device SIM / line.
# BRWN_DEFAULT_BUSINESS_PHONE=+15551234567

# Messaging provider (default brwn-relay).
# Staging / local evidence runs: MESSAGING_PROVIDER=dry-run (logs only; never hits relay)
# MESSAGING_PROVIDER=brwn-relay
# MESSAGING_PROVIDER=dry-run

# One Gateway (all AI/LLM calls — OpenAI-compatible OpenClaw proxy)
# https://github.com/abrown84/one-gateway
# Optional: gateway auth token (openclaw.json → gateway.auth.token).
# Authorization is only sent when this is set.
# ONE_GATEWAY_TOKEN=your_openclaw_gateway_token
# Gateway base URL (default: https://brwnindustries.com/labs/one-gateway).
# App appends /v1 for OpenAI-compatible chat completions. Remote must use https://
# ONE_GATEWAY_URL=https://brwnindustries.com/labs/one-gateway
# Model routed through the gateway (default: gemini-3.8-flash)
# ONE_GATEWAY_MODEL=gemini-3.8-flash
# Optional: OpenClaw agent id (default: main)
# ONE_GATEWAY_AGENT=main
# Optional: request timeout in ms (default: 45000)
# ONE_GATEWAY_TIMEOUT_MS=45000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production: Bearer token for /api/cron/campaigns
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically when set.
CRON_SECRET=generate-a-long-random-string

# Optional: Analytics/Logging
# SENTRY_DSN=
