# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token

# One Gateway (all AI/LLM calls — OpenAI-compatible OpenClaw proxy)
# https://github.com/abrown84/one-gateway
# Required: gateway auth token (openclaw.json → gateway.auth.token)
ONE_GATEWAY_TOKEN=your_openclaw_gateway_token
# Gateway base URL (default: http://127.0.0.1:18789). Remote must use https://
ONE_GATEWAY_URL=http://127.0.0.1:18789
# Model routed through the gateway (default: gemini-3.8-flash)
ONE_GATEWAY_MODEL=gemini-3.8-flash
# Optional: OpenClaw agent id (default: main)
# ONE_GATEWAY_AGENT=main
# Optional: request timeout in ms (default: 45000)
# ONE_GATEWAY_TIMEOUT_MS=45000

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics/Logging
# SENTRY_DSN=
