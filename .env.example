# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token

# One Gateway (all AI/LLM calls — OpenAI-compatible OpenClaw proxy)
# https://github.com/abrown84/one-gateway
# Optional: gateway auth token (openclaw.json → gateway.auth.token).
# Authorization is only sent when this is set.
# ONE_GATEWAY_TOKEN=your_openclaw_gateway_token
# Gateway base URL (default: https://brwnindustries.com/labs/one-gateway).
# App appends /v1 for OpenAI-compatible chat completions. Remote must use https://
# ONE_GATEWAY_URL=https://brwnindustries.com/labs/one-gateway
# Model routed through the gateway (default: gemini-3.8-flash)
# ONE_GATEWAY_MODEL=gemini-3.8-flash
# Optional: OpenClaw agent id (default: main)
# ONE_GATEWAY_AGENT=main
# Optional: request timeout in ms (default: 45000)
# ONE_GATEWAY_TIMEOUT_MS=45000

# App Configuration
# Used for Twilio signature validation — must match the public URL Twilio calls.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production: Bearer token for /api/cron/campaigns
# Vercel Cron sends Authorization: Bearer $CRON_SECRET automatically when set.
CRON_SECRET=generate-a-long-random-string

# Optional: Analytics/Logging
# SENTRY_DSN=
